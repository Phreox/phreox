# Build context is the repository root: docker build -f Dockerfile.space .
FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /src

# The parent pom lists every module, so all of them must be present even though only the space node is built.
COPY pom.xml .
COPY phreox-api phreox-api
COPY phreox-server-common phreox-server-common
COPY phreox-backend phreox-backend
COPY phreox-service phreox-service
COPY phreox-space phreox-space

RUN mvn -B -q -pl phreox-space -am -DskipTests package

FROM eclipse-temurin:25-jre
RUN useradd --system --create-home --uid 10001 phreox && mkdir /data && chown phreox /data

COPY --from=build /src/phreox-space/target/phreox-space.jar /app/phreox-space.jar

USER phreox
ENV PHREOX_SPACE_DATA_DIR=/data
VOLUME /data

ENTRYPOINT ["java", "-jar", "/app/phreox-space.jar"]
