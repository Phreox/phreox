# Copy to .env. Read by docker compose and by the desktop app in development.
PHREOX_SERVICE_PORT=8081
PHREOX_SERVICE_URLS=http://127.0.0.1:8081
# Klipy app key (https://klipy.com) for the GIF search of the service. Keep it out of git.
PHREOX_KLIPY_KEY=

# Cluster node (docker compose --profile cluster). The node logs in with this account and registers itself at the service,
# the account must exist (register it once through the app or POST /auth/register).
PHREOX_SPACE_PORT=8082
PHREOX_SPACE_PUBLIC_URL=http://127.0.0.1:8082
PHREOX_SPACE_USERNAME=space-node
PHREOX_SPACE_PASSWORD=
# Only for official nodes on reserved domains (phreox.talk); also read by the service. Keep it out of git.
PHREOX_SERVICE_ADMIN_TOKEN=
