# Copy to .env. Read by docker compose and by the desktop app in development.
PHREOX_SERVICE_PORT=8081
# Roots in priority order. The second one is the same service on the LAN address of the test machine.
PHREOX_SERVICE_URLS=http://127.0.0.1:8081,http://10.52.10.48:8081
# Klipy app key (https://klipy.com) for the GIF search of the service. Keep it out of git.
PHREOX_KLIPY_KEY=

# Cluster node (docker compose --profile cluster). The node registers itself at the service with its own key (data/node.key):
# it needs no account. Its console sets it up (type help), and the first person who comes in with an invite code owns it.
PHREOX_SPACE_PORT=8082
PHREOX_SPACE_PUBLIC_URL=http://127.0.0.1:8082
# Only for official nodes on reserved domains (phreox.talk); also read by the service. Keep it out of git.
PHREOX_SERVICE_ADMIN_TOKEN=

# Backend for phones (docker compose --profile mobile). The phone app asks for the address and this token.
PHREOX_BRIDGE_PORT=8090
PHREOX_BRIDGE_HOSTS=10.52.10.48:8090
PHREOX_BRIDGE_TOKEN=
PHREOX_LOCAL_KEY=

# Space node customization. Templates apply when creating new spaces.
PHREOX_SPACE_DEFAULT_CATEGORY=Text
PHREOX_SPACE_DEFAULT_CHANNEL=general
PHREOX_SPACE_DEFAULT_PRIVATE_CHANNEL=
PHREOX_SPACE_OWNER_ROLE=Owner
PHREOX_SPACE_MODERATOR_ROLE=Moderator
PHREOX_SPACE_MEMBER_ROLE=Member
PHREOX_SPACE_MAX_FILE_BYTES=2147483648
PHREOX_SPACE_FLUSH_SECONDS=5
PHREOX_SPACE_ORIGINS=
